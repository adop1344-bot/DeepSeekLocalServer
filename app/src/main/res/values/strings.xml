    <string name="onboarding_step1_body">This is your DeepSeek web token. It lets the app call chat.deepseek.com on your behalf. It is stored encrypted on this device only.</string>
    <string name="onboarding_step2_title">Step 1: Bookmarklet</string>
    <string name="onboarding_step2_body">Open Firefox/Kiwi, create a bookmark with any name, paste this into the URL field. Then open bookmarks and tap it on the DeepSeek tab.</string>
    <string name="onboarding_step3_title">Step 2: Sign in</string>
    <string name="onboarding_step3_body">Open chat.deepseek.com and sign in to your account.</string>
    <string name="onboarding_step4_title">Step 3: Copy token</string>
    <string name="onboarding_step4_body">F12 → Application → Local Storage → userToken. Copy the value field.</string>
    <string name="onboarding_step5_title">Step 4: Paste</string>
    <string name="onboarding_step5_body">Paste the token below and press Check.</string>
